# Copy this file to .env and fill in real values before deploying.

PORT=3000

# Where persistent data lives (submission history log + saved PDFs). On Render,
# set this to match your attached persistent disk's mount path (e.g. /var/data)
# so this survives restarts/redeploys. Defaults to a local ./data folder, which
# is fine for local testing but NOT durable on Render's free tier.
DATA_DIR=./data

# Asana sync (optional): a Personal Access Token from Asana -
# My Settings -> Apps -> Manage Developer Apps -> Personal Access Tokens.
# Once set, and once config/asanaFieldMap.json has the real field/option
# GIDs filled in, approval decisions in this app automatically update the
# matching PO's Asana task. Leave unset to skip this entirely - nothing
# else in the app depends on it.
ASANA_ACCESS_TOKEN=
