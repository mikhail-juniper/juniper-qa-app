# Copy this file to .env and fill in real values before deploying.

PORT=3000

# Who receives the QA/QC report emails (comma-separated for multiple)
REPORT_RECIPIENTS=mikhail@junipercreates.com

# --- SMTP settings for sending email ---
# IMPORTANT: Gmail/Google Workspace SMTP is NOT reliable from mainland China.
# Recommended China-friendly options instead:
#   - Alibaba Cloud DirectMail (https://www.alibabacloud.com/product/directmail)
#   - Tencent Cloud SES (https://cloud.tencent.com/product/ses)
#   - SendGrid / Mailgun / Postmark (these work, but the app's SERVER should be
#     hosted outside mainland China, e.g. Hong Kong/Singapore, since the factory
#     staff only need to reach the app's web server over HTTPS, not the SMTP
#     provider directly - the server does the emailing on their behalf)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=qa-reports@junipercreates.com

# If true, also attach full-resolution original photos to the email
# (in addition to the compressed versions embedded in the PDF).
# Careful: this can make emails large if many photos are taken.
ATTACH_FULL_RES_PHOTOS=false

# If true, keep a copy of every generated PDF on the server's disk
# in the /submissions folder as a backup / audit trail.
SAVE_LOCAL_COPY=true
