# Copy this file to .env and fill in real values before deploying.

PORT=3000

# Where persistent data lives (submission history log + saved PDFs). On Render,
# set this to match your attached persistent disk's mount path (e.g. /var/data)
# so this survives restarts/redeploys. Defaults to a local ./data folder, which
# is fine for local testing but NOT durable on Render's free tier.
DATA_DIR=./data

# Asana sync (optional): a Personal Access Token from Asana -
# My Settings -> Apps -> Manage Developer Apps -> Personal Access Tokens.
# This ONE token powers all Asana features; there is no second variable.
#   - Approval sync (Sample/PP/Bulk) uses config/asanaFieldMap.json
#   - Full PO field sync uses config/asanaPoSync.json
# Leave unset to skip Asana entirely - nothing else in the app depends on it.
ASANA_ACCESS_TOKEN=

# The "Sync from Asana" button on the New PO form additionally needs
# projectGid filled in inside config/asanaPoSync.json (the Purchase Orders
# project). That's a committed config file, not an environment variable.
# Pushes from this app to Asana work without it, since they use the task
# link stored on each PO.

# Optional. Only used to build absolute links (QA/QC Drive Link, Inspection
# Result) in background jobs that have no incoming request to read the host
# from. Set it to the app's public URL if those links ever come out relative.
# PUBLIC_BASE_URL=https://your-app.onrender.com


# ---- Google sign-in (optional, for Juniper staff) ----
# Create an OAuth 2.0 Client ID at https://console.cloud.google.com/apis/credentials
#   Application type: Web application
#   Authorised redirect URI: https://YOUR-DOMAIN/auth/google/callback
# Leave unset and the Google button simply doesn't appear on the login page.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Restrict sign-in to one Google Workspace domain (recommended). With this
# set, a staff member signing in for the first time is auto-provisioned with
# the "internal" role. Without it, only people who already have an account
# in Settings > Users can sign in - no auto-provisioning, since otherwise
# any Google account anywhere could create itself access.
GOOGLE_ALLOWED_DOMAIN=

# mikhail@junipercreates.com is ALWAYS admin - that's built into the code
# (lib/googleAuth.js BUILT_IN_ADMIN_EMAILS) so the owner account can't be
# locked out by a missing env var, and is restored to admin on sign-in if it
# ever isn't. The variable below ADDS to that list, it doesn't replace it.
#
# Emails that should be created as ADMIN on their first Google sign-in.
# Everyone else on an allowed domain is created as "internal" (Juniper Team).
# Only applies when the account is first created - it never re-promotes
# someone whose role an admin has deliberately changed. Without this, no one
# can reach admin via Google and you'd rely on the shared site password.
GOOGLE_ADMIN_EMAILS=

# ---- Sending email from inside the app (optional) ----
# Uses the Gmail API so a PO really is sent from the sender's own Gmail: it
# lands in their Sent folder and the factory's reply goes back to them.
#
# No extra env vars are needed - it reuses GOOGLE_CLIENT_ID/SECRET above.
# Setup in Google Cloud:
#   1. Enable the "Gmail API" for the project.
#   2. Set the OAuth consent screen to INTERNAL (Workspace-only). The
#      gmail.send scope is classified Sensitive; an Internal consent screen
#      avoids the verification process entirely. External would require
#      brand verification first.
#   3. Add the scope https://www.googleapis.com/auth/gmail.send
#   4. If Workspace restricts sensitive scopes, mark this OAuth client as
#      trusted in the Admin console (Security > API controls).
# Each person then clicks "Connect Gmail" once, from the send dialog.
#
# SESSION_SECRET doubles as the encryption key for stored Gmail refresh
# tokens. Changing it invalidates them and everyone reconnects - which is
# the safe direction, but set it once and leave it.

# Public URL of the app. Used to build the Google callback and the supplier
# access links when they're generated outside a normal request.
# PUBLIC_BASE_URL=https://juniper-qa-app.onrender.com


# ---- WeChat sign-in (optional, for the China team) ----
# Dormant unless both values are set; the button simply doesn't appear.
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Which kind of WeChat account you're using:
#   oa  (default) Official Account / 公众号 web authorization.
#                 Works ONLY inside WeChat's own in-app browser - the button
#                 is hidden on desktop because it would silently fail there.
#                 Needs a VERIFIED Service Account (服务号, not 订阅号) and
#                 the callback domain registered in the OA admin under
#                 "Web authorization domain", including uploading the
#                 verification TXT file to the site root.
#   qr            Open Platform / 开放平台 website app, desktop QR scan.
#                 Requires the callback domain to have completed ICP filing,
#                 which needs mainland hosting and a Chinese entity.
WECHAT_MODE=oa
#
# Callback to register: https://YOUR-DOMAIN/auth/wechat/callback
#
# There is deliberately NO auto-provisioning for WeChat: unlike a Google
# Workspace address, a WeChat identity carries nothing that proves who the
# person works for. The first sign-in is refused and shows the OpenID; an
# admin links it to an account on the Users page (the WeChat button on each
# row). After that, sign-in works normally.


# ---- WeCom / 企业微信 sign-in (recommended for the China team) ----
# Preferred over the consumer-WeChat block above: it works on desktop as
# well as inside the WeCom app, and a WeCom userid is only issued to a
# member of your own WeCom organisation - so membership is already verified
# and first-time sign-ins are auto-provisioned as "Juniper Team", the same
# as a Google Workspace address. Someone outside the org (an external
# contact) is refused.
#
# From the WeCom admin console (work.weixin.qq.com):
#   CorpID:  My Company > Company Info
#   AgentId
#   and Secret: App Management > your internal app
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
#
# In the app's settings, register:
#   Trusted domain / 可信域名:        juniper-qa-app.onrender.com
#   OAuth callback / 网页授权回调域:   juniper-qa-app.onrender.com
# Full callback URL: https://YOUR-DOMAIN/auth/wecom/callback
#
# WeCom also requires the server's outbound IP to be allow-listed under the
# app's "Trusted IPs" (企业可信IP) before API calls succeed. On Render that
# means adding the static outbound IPs from your service's Connect panel.
